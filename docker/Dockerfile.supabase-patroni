# =============================================================================
# Supabase PostgreSQL with Patroni HA
# =============================================================================
# Base: supabase/postgres:15.8.1.085 (official Supabase image)
# Added: Patroni for high availability with etcd
#
# Build: docker build -t supabase-patroni:latest -f docker/Dockerfile.supabase-patroni docker/
# =============================================================================

FROM supabase/postgres:15.8.1.085

LABEL maintainer="PostgreSQL HA Project"
LABEL description="Supabase PostgreSQL with Patroni HA"

USER root

# Install Patroni and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-psycopg2 \
    curl \
    jq \
    netcat-openbsd \
    && pip3 install --no-cache-dir \
        patroni[etcd3]==3.3.2 \
        python-etcd==0.4.5 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /etc/patroni \
    && mkdir -p /home/postgres/pgdata \
    && chown -R postgres:postgres /home/postgres \
    && chown -R postgres:postgres /etc/patroni

# Copy Patroni config and entrypoint
COPY patroni.yml /etc/patroni/patroni.yml.template
COPY scripts/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && chown postgres:postgres /etc/patroni/patroni.yml.template \
    && chown postgres:postgres /entrypoint.sh

# Default environment variables
ENV PATRONI_SCOPE=supabase-ha \
    PATRONI_NAME=patroni1 \
    PATRONI_RESTAPI_LISTEN=0.0.0.0:8008 \
    PATRONI_RESTAPI_CONNECT_ADDRESS=localhost:8008 \
    PATRONI_POSTGRESQL_LISTEN=0.0.0.0:5432 \
    PATRONI_POSTGRESQL_CONNECT_ADDRESS=localhost:5432 \
    PATRONI_POSTGRESQL_DATA_DIR=/home/postgres/pgdata/data \
    PATRONI_ETCD3_HOSTS=etcd1:2379,etcd2:2379,etcd3:2379 \
    PATRONI_SUPERUSER_USERNAME=postgres \
    PATRONI_SUPERUSER_PASSWORD=postgres \
    PATRONI_REPLICATION_USERNAME=replicator \
    PATRONI_REPLICATION_PASSWORD=replicator \
    PGDATA=/home/postgres/pgdata/data

USER postgres

EXPOSE 5432 8008

HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=5 \
    CMD pg_isready -U postgres || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["patroni", "/etc/patroni/patroni.yml"]
